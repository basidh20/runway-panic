  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 26
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "<b>RUNWAY PANIC</b>\nAirport Bird Control\n\n<color=#E0731F>SE3032 Graphics & Visualization  \xD7  SE3062 Intelligent Systems</color>\nSLIIT group project\n\n<b>World Builder</b>  \xB7  airport, level and integration\n<b>Systems Engineer</b>  \xB7  player, weapons, shop, pickups, menus, audio\n<b>Core Developer</b>  \xB7  3D models and bird prefabs\n<b>Agent Controller</b>  \xB7  bird movement and animation\n<b>Intelligent Systems</b>  \xB7  A* flight pathfinding and the gull, pigeon, crow and hawk brains\n\nMade with Unity 6 \xB7 all sound generated in-project"
